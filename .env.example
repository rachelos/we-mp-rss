# ============================================================
# WeRSS 环境变量配置文件示例
# 复制此文件为 .env 并修改对应的值
# cp .env.example .env
# ============================================================

# ---------- 应用基础 ----------
APP_NAME=we-mp-rss
SECRET_KEY=                  # 安全密钥，生产环境请设置强随机密钥
DEBUG=False                  # 调试模式
PORT=8001                    # API 服务端口

# ---------- 服务配置 ----------
SERVER_NAME=we-mp-rss        # 服务名称
WEB_NAME=WeRSS微信公众号订阅助手  # 前端显示名称
SEND_CODE=False              # 过期是否发送授权二维码通知
CODE_TITLE=WeRSS             # 二维通知标题
ENABLE_JOB=True              # 启动 JOB 定时任务
AUTO_RELOAD=False            # 代码修改自动重启服务
THREADS=1                    # 最大线程数，不建议超过4
WERSS_AUTH_WEB=False         # 通过 web 方式授权二维码

# ---------- 初始化用户 ----------
USERNAME=admin
PASSWORD=admin@123

# ---------- 数据库 ----------
# SQLite:   sqlite:///./data/db.db
# MySQL:    mysql+pymysql://<username>:<password>@<host>/<database>?charset=utf8mb4
# PostgreSQL: postgresql://<username>:<password>@<host>/<database>
DB=sqlite:///./data/db.db

# MySQL (Docker 部署时使用)
MYSQL_ROOT_PASSWORD=rootpass123
MYSQL_DATABASE=we_mp_rss
MYSQL_USER=rss_user
MYSQL_PASSWORD=pass123456

# ---------- Redis ----------
REDIS_URL=redis://127.0.0.1:6379/0
REDIS_SERVER_ENABLED=True
REDIS_SERVER_HOST=0.0.0.0
REDIS_SERVER_PORT=6379
REDIS_SERVER_MAX_MEMORY=128   # 最大内存 (MB)
REDIS_SERVER_PASSWORD=        # 认证密码，为空则不需要认证
REDIS_SERVER_PERSISTENCE=true

# ---------- 时区 ----------
TZ=Asia/Shanghai

# ---------- 文章统计 ----------
ARTICLE_STATS_REFRESH_ENABLED=False
ARTICLE_STATS_REFRESH_INTERVAL=3600

# ---------- 通知 Webhook ----------
DINGDING_WEBHOOK=             # 钉钉通知
WECHAT_WEBHOOK=               # 企业微信通知
FEISHU_WEBHOOK=               # 飞书通知
CUSTOM_WEBHOOK=               # 自定义通知

# ---------- 采集配置 ----------
SPAN_INTERVAL=11              # 定时任务每篇稿件间隔时间（秒）
MAX_PAGE=5                    # 第一次添加采集的页数
GATHER_CONTENT=False          # 是否采集内容
GATHER_MODEL=web              # 采集模式: web / api / app
GATHER_CONTENT_AUTO_CHECK=True
GATHER_CONTENT_AUTO_INTERVAL=59
GATHER_CONTENT_MODE=web
GATHER_CLEAN_HTML=False
BROWSER_TYPE=edge             # 浏览器类型: firefox / edge / webkit
USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36/WeRss

# ---------- 代理 ----------
PROXY_ENABLED=False
PROXY_DENO_URL=               # Deno Deploy 代理地址
PROXY_HTTP_URL=               # HTTP 代理地址，如 http://127.0.0.1:7890

# ---------- Webhook 内容格式 ----------
WEBHOOK.CONTENT_FORMAT=markdown  # html / text / markdown

# ---------- RSS ----------
RSS_BASE_URL=                 # RSS 域名地址，如 https://www.xxx.com/
RSS_LOCAL=False               # 是否为本地 RSS 链接
RSS_TITLE=
RSS_DESCRIPTION=
RSS_COVER=
RSS_FULL_CONTEXT=True         # 是否显示全文
RSS_ADD_COVER=True            # 是否添加封面图片
RSS_CDATA=False               # RSS 正文是否启用 CDATA
RSS_PAGE_SIZE=30              # RSS 分页大小

# ---------- 登录会话 ----------
TOKEN_EXPIRE_MINUTES=4320     # 会话有效时长（分钟），默认 3 天

# ---------- 缓存 ----------
CACHE.DIR=./data/cache
CACHE.ENABLED=True
CACHE.TTL=3600
CACHE.VIEWS.ENABLED=False
CACHE.VIEWS.DIR=./data/cache/views
CACHE.VIEWS.TTL=1800

# ---------- 文章 ----------
ARTICLE.TRUE_DELETE=False     # 是否真实删除文章

# ---------- 日志 ----------
LOG_FILE=                     # 日志文件路径，为空则不记录
LOG_LEVEL=INFO                # DEBUG / INFO / WARNING / ERROR / CRITICAL

# ---------- 导出 ----------
EXPORT_PDF=False
EXPORT_PDF_DIR=./data/pdf
EXPORT_MARKDOWN=False
EXPORT_MARKDOWN_DIR=./data/markdown

# ---------- 安全 ----------
SAFE_HIDE_CONFIG=db,secret,token,notice.wechat,notice.feishu,notice.dingding
SAFE_LIC_KEY=RACHELOS

# ---------- 微信账号 ----------
WECHAT_ALLOWED_ACCOUNTS=      # 允许切换的账号 ID，逗号分隔，为空表示允许所有

# ---------- 级联部署 ----------
CASCADE_ENABLED=False
CASCADE_NODE_TYPE=child       # child / parent
CASCADE_PARENT_API_URL=http://localhost:8001
CASCADE_API_KEY=
CASCADE_API_SECRET=
CASCADE_SYNC_INTERVAL=300
CASCADE_HEARTBEAT_INTERVAL=60
CASCADE_TASK_POLL_INTERVAL=30

# ---------- 站点信息 ----------
SITE_NAME=WeRss
SITE_DESCRIPTION=A WeChat Official Account RSS Reader
SITE_KEYWORDS=WeChat,Official Account,RSS,Reader

# ---------- 文章统计刷新 ----------
ARTICLE_STATS_REFRESH_ENABLED=False
ARTICLE_STATS_REFRESH_INTERVAL=3600
